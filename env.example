# OpenRouter API key (required) — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use via OpenRouter (optional, defaults shown)
OPENROUTER_MODEL=x-ai/grok-2-1212

# Used in OpenRouter request headers (optional)
APP_URL=http://localhost:3000
APP_NAME=GridWise Energy Optimizer

# Port the server listens on (optional, defaults to 3000)
PORT=3000
